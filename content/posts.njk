---
layout: base.njk
title: Posts
description: A chronological archive of notes, essays, and technical writing.
permalink: /posts/
---
{% from "components/post-card.njk" import postCard %}

<section class="section">
  <div class="section-header">
    <p class="eyebrow">Archive</p>
    <h1>Posts</h1>
    <p class="section-copy">
      Short essays, technical notes, and durable writeups. This archive starts
      small on purpose.
    </p>
  </div>

  <div class="post-grid">
    {% for post in collections.posts %}
      {{ postCard(post, loop.first and collections.posts.length == 1) }}
    {% endfor %}
  </div>
</section>
