---
layout: base.njk
title: Posts
description: A chronological archive of notes, essays, and technical writing.
permalink: /posts/
---

<section class="section-block">
  <h1 class="page-title">Posts</h1>

  {% if collections.posts.length %}
    <ul class="writing-list">
      {% for post in collections.posts %}
        <li>
          <span class="writing-date">{{ post.date | shortDate }}</span>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="writing-empty">Nothing published yet.</p>
  {% endif %}
</section>
