<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {% if title and title != site.title %}
        {{ title }} | {{ site.title }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </title>
    <meta name="description" content="{{ description or summary or site.description }}" />
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Feed" href="{{ "/feed.xml" | absoluteUrl(site.url) }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or summary or site.description }}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
    <meta property="og:image" content="{{ "/images/og-default.png" | absoluteUrl(site.url) }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title or site.title }}" />
    <meta name="twitter:description" content="{{ description or summary or site.description }}" />
    <meta name="twitter:image" content="{{ "/images/og-default.png" | absoluteUrl(site.url) }}" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
    {% if math %}<link rel="stylesheet" href="/assets/vendor/katex.min.css" />{% endif %}
    <link rel="stylesheet" href="/assets/vendor/highlight.css" />
    <link rel="stylesheet" href="/assets/css/site.css" />
  </head>
  <body>
    <div class="site-container">
      <header class="site-sidebar">
        <p class="site-name">
          <a href="/">
            <img class="site-avatar" src="/images/avatar.jpg" alt="{{ site.name }}" width="56" height="56" />
            <span>{{ site.name }}</span>
          </a>
        </p>

        <nav aria-label="Primary">
          <ul class="sidebar-list">
            {% for item in site.nav %}
              <li>
                <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
              </li>
            {% endfor %}
          </ul>
        </nav>

        {% if site.elsewhere %}
          <p class="sidebar-label">Elsewhere</p>
          <ul class="sidebar-list">
            {% for item in site.elsewhere %}
              <li><a href="{{ item.href }}" rel="me">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if site.subscribe %}
          <p class="sidebar-label">Subscribe</p>
          <ul class="sidebar-list">
            {% for item in site.subscribe %}
              <li><a href="{{ item.href }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

      </header>

      <main class="site-main">
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p>© {% year %} {{ site.name }}</p>
      </footer>
    </div>

    {% if math %}
      <script defer src="/assets/vendor/katex.min.js"></script>
      <script defer src="/assets/vendor/katex-auto-render.min.js"></script>
      <script defer src="/assets/js/math.js"></script>
    {% endif %}
    {% if mermaid %}
      <script type="module" src="/assets/js/mermaid.js"></script>
    {% endif %}
  </body>
</html>
